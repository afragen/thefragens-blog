---
/**
 * AutoGallery.astro
 *
 * Drop-in replacement for <Gallery> inside MDX blog posts.
 * Uses a broad static glob to collect every blog post's images at build time,
 * then narrows to the current post and delegates to Gallery.astro.
 *
 * The current post is identified by the `postId` prop (the content collection
 * entry id, e.g. "2026/pressconf-2026-in-pictures"). This is passed from
 * [...slug].astro and is stable at build time on ANY host — unlike
 * Astro.url.pathname, which is unreliable during prerender on platforms like
 * Cloudflare Pages (where it can resolve to "/" or empty and break the filter).
 *
 * Usage in any blog MDX post (no imports needed):
 *   <Gallery title="Photos" columns={3} />
 *
 * Wiring: the `remarkAutoGallery` plugin in astro.config.mjs detects any MDX
 * file that uses <Gallery> and injects
 * `import Gallery from '@components/AutoGallery.astro'`. [...slug].astro passes
 * `components={{ Gallery: AutoGallery }}` and supplies `postId`.
 */

import type { ImageMetadata } from 'astro'
import Gallery from './Gallery.astro'

interface Props {
  title?: string
  columns?: number
  /** Content collection entry id, e.g. "2026/pressconf-2026-in-pictures". */
  postId?: string
}

const { title, columns, postId } = Astro.props

// Vite resolves this static glob at build time, collecting every image across
// all blog posts. Filtering to the current post happens below.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  [
    '../content/blog/**/images/*.{jpg,jpeg,png,gif,webp,avif,svg}',
    '../content/blog/**/images/*.{JPG,JPEG,PNG,GIF,WEBP,AVIF,SVG}',
  ],
  { eager: true }
)

// Stable build-time post id takes priority. Fall back to the request URL for
// environments where postId isn't supplied (local dev, non-CF hosts).
function postIdFromUrl(): string {
  let p = Astro.url.pathname
  if (p.startsWith('/blog/')) p = p.slice('/blog/'.length)
  return p.replace(/\/+$/, '')
}
const postPath = postId ?? postIdFromUrl()

const images = Object.entries(allImages)
  .filter(([path]) => path.includes(`/blog/${postPath}/images/`))
  .map(([, mod]) => mod.default)
---

{images.length > 0 ? <Gallery {images} {title} {columns} /> : null}
