---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import FallbackImage from '../assets/background-operate.png';
import { SITE_TITLE } from '../consts';
import { palette } from '../palette';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image = FallbackImage } = Astro.props;
const ogImage = new URL(image.src, Astro.site).href;
---

<!-- Color palette CSS variables -->
<style set:html={`
	:root {
		--accent: ${palette.accent};
		--accent-dark: ${palette.accentDark};
		--black: ${palette.black};
		--gray: ${palette.gray};
		--gray-light: ${palette.grayLight};
		--gray-dark: ${palette.grayDark};
		--gray-gradient: rgba(${palette.grayLight}, 50%), #fff;
		--box-shadow:
			0 2px 6px rgba(${palette.gray}, 25%), 0 8px 24px rgba(${palette.gray}, 33%),
			0 16px 32px rgba(${palette.gray}, 33%);
	}
`} />

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- MonaSans — loaded asynchronously so the font is off the critical request chain.
     font-display: optional means no layout shift; the font is used once cached. -->
<link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="/fonts/fonts.css" /></noscript>

<Seo
	title={title}
	titleTemplate="%s | thefragens"
	description={description}
	ogType="website"
	ogImage={ogImage}
	ogImageAlt={title}
	ogImageWidth={1200}
	ogImageHeight={630}
	siteName={SITE_TITLE}
	extraLinks={[
		{ rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
		{ rel: 'icon', href: '/favicon.ico' },
		{ rel: 'sitemap', href: '/sitemap-index.xml' },
		{ rel: 'alternate', type: 'application/rss+xml', title: SITE_TITLE, href: new URL('rss.xml', Astro.site).href },
	]}
/>
